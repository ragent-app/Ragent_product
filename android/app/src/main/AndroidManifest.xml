<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".AgentoCApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Ragent"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Agentoc">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Agentoc.Splash"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/capture_shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 配对深链: 相机/其他 App 识别 agentoc://pair 后可直接唤起本 App -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agentoc" android:host="pair" />
                <data android:scheme="riollant" android:host="pair" />
                <data android:scheme="ragent" android:host="pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agentoc" android:host="session" />
                <data android:scheme="riollant" android:host="session" />
                <data android:scheme="ragent" android:host="session" />
            </intent-filter>
        </activity>
        <activity android:name=".PairingQrScannerActivity" android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".AppApiSettingsActivity" android:exported="false" />
        <activity android:name=".CallerConsentActivity" android:exported="true">
            <intent-filter>
                <action android:name="com.agentoncloud.android.action.REQUEST_API_ACCESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".CallerGrantsActivity" android:exported="false" />
        <activity android:name=".AssistantDelegationActivity" android:exported="false" />
        <service android:name=".AppApiService" android:exported="true">
            <intent-filter>
                <action android:name="com.agentoncloud.android.action.BIND_APP_API" />
            </intent-filter>
        </service>
        <activity android:name=".ShareDraftActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".DraftInboxActivity" android:exported="false" />
        <activity android:name=".ResultOutputsActivity" android:exported="false" />
        <activity android:name=".ProcessTextActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name=".NewCaptureActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".FreshCaptureActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".FreshShareReceiverActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ShareRouterActivity" android:exported="true"
            android:label="@string/share_route_system_target" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity android:name=".ShareReceiverActivity" android:exported="false" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".TemporaryShareReceiverActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Phase3RActivity"
            android:exported="true" />
        <service
            android:name=".DocumentExportService"
            android:exported="false"
            android:process=":document_export" />
        <service
            android:name=".ResultMaintenanceJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
        <service
            android:name=".BackgroundDeliveryJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
        <service
            android:name=".BackgroundDeliveryForegroundService"
            android:enabled="@bool/background_delivery_legacy_service_enabled"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".StopBackgroundDeliveryReceiver"
            android:exported="false" />
        <service
            android:name=".AgentoCFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name=".ResultShareFileProvider"
            android:authorities="${applicationId}.result-files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/result_share_paths" />
        </provider>
    </application>
</manifest>
