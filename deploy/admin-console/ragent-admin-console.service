[Unit]
Description=Ragent owner-only admin console
After=network-online.target ragent-admin-helper.service
Wants=network-online.target
Requires=ragent-admin-helper.service

[Service]
Type=simple
User=ragent-admin
Group=ragent-admin
SupplementaryGroups=ragent-admin
EnvironmentFile=/etc/ragent/admin-console.env
Environment=RAGENT_ADMIN_HOST=127.0.0.1
Environment=RAGENT_ADMIN_PORT=7722
Environment=RAGENT_ADMIN_SOCKET=/run/ragent-admin/helper.sock
Environment=RAGENT_ADMIN_BACKUP_DIR=/var/lib/ragent-admin/backups
Environment=RAGENT_ADMIN_PUBLIC_DIR=/opt/ragent-admin/current/public
WorkingDirectory=/opt/ragent-admin/current
ExecStart=/opt/ragent-accounts/current/runtime/node /opt/ragent-admin/current/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/ragent-admin/current /var/lib/ragent-admin/backups
ReadWritePaths=/run/ragent-admin

[Install]
WantedBy=multi-user.target
