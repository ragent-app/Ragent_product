[Unit]
Description=Ragent accounts API (production)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ragent-accounts
Group=ragent-accounts
RuntimeDirectory=ragent-accounts
# Accounts has its own versioned release and runtime. It must not execute from
# the local-control-plane Deb tree under /opt/ragent.
ExecStart=/opt/ragent-accounts/current/runtime/node /opt/ragent-accounts/current/app/accounts/server.mjs
EnvironmentFile=/etc/ragent/accounts.env
WorkingDirectory=/opt/ragent-accounts/current/app
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
TimeoutStopSec=20
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ragent/accounts
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
