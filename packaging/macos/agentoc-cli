#!/bin/bash
# Ragent CLI shim: run the packaged cli.js with the bundled Node runtime.
set -euo pipefail

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/ragent-env.sh"

agentoc_source_instance_env
agentoc_ensure_runtime_shims

exec "$AGENTOC_NODE_BIN" "$AGENTOC_APP_DIR/cli.js" "$@"
