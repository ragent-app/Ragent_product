#!/bin/bash
# Opt-in login service management. Never runs on installation by itself.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/ragent-env.sh"
ragent_source_instance_env
exec "$RAGENT_NODE_BIN" "$RAGENT_RESOURCES_DIR/ragent-login.cjs" \
  "${1:-status}" "$RAGENT_RESOURCES_DIR" "$(ragent_config_dir)" "${CHAT_PORT:-7690}"
