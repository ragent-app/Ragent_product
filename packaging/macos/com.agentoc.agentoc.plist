<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cloud.agenton.agentoc</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{APP_PATH}}/Contents/MacOS/agentoc-service</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SECURE_COOKIES</key>
        <string>0</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>Umask</key>
    <integer>63</integer>
    <key>WorkingDirectory</key>
    <string>{{HOME}}</string>
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/agentoc.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/agentoc.error.log</string>
</dict>
</plist>
