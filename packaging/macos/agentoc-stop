#!/bin/bash
# Stop the AgentoC chat server started by the app launcher.
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/agentoc-env.sh"

agentoc_source_instance_env

pid="$(agentoc_server_pid 2>/dev/null || true)"
if [ -n "$pid" ]; then
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.25
  done
  if agentoc_is_server_pid "$pid"; then
    printf 'AgentoC chat server did not stop (pid %s)\n' "$pid" >&2
    exit 1
  fi
  rm -f "$AGENTOC_PID_FILE"
  printf 'AgentoC chat server stopped (pid %s)\n' "$pid"
  exit 0
fi

PORT="${CHAT_PORT:-7690}"
pids="$(lsof -ti ":${PORT}" -sTCP:LISTEN 2>/dev/null || true)"
if [ -n "$pids" ]; then
  # Only kill processes whose command line is the packaged chat server.
  for pid in $pids; do
    if agentoc_is_server_pid "$pid"; then
      kill "$pid" 2>/dev/null || true
      printf 'AgentoC chat server stopped (pid %s)\n' "$pid"
    fi
  done
  exit 0
fi

printf 'AgentoC chat server is not running\n'
exit 0
