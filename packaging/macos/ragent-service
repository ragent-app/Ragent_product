#!/bin/bash
# LaunchAgent entry point: use the same initialization and environment as the app.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/ragent-env.sh"
ragent_first_run_bootstrap
ragent_source_instance_env
ragent_ensure_runtime_shims
exec "$RAGENT_NODE_BIN" "$RAGENT_APP_DIR/chat-server.mjs"
