CHAT_BIND_HOST=127.0.0.1
CHAT_PORT=7690
SECURE_COOKIES=1
RAGENT_CONFIG_DIR=/var/lib/ragent/config
RAGENT_WORK_ROOT_DIR=/var/lib/ragent/workspace
RAGENT_MEMORY_DIR=/var/lib/ragent/memory
RAGENT_CHAT_BASE_URL=http://127.0.0.1:7690
# Socket paths for systemd services are fixed by the packaged socket units.
RAGENT_RUNNER_SUPERVISOR_REQUIRED=1
# Same-user runner mode: ordinary Runs use the configured service UID/GID so
# legacy user-owned worktrees remain readable and writable. Privileged group
# inheritance is still filtered by the fixed runner deny-list.
RAGENT_RUNNER_SAME_USER=1
RAGENT_RUNNER_LIFECYCLE_REQUIRED=1
# P0-C: the runner-accessible subtrees (run spool + provider credential homes)
# live under the runner state root, NOT under the control CONFIG_DIR.  This is
# what lets postinst drop the runner group's config traverse ACL.
RAGENT_RUN_SPOOL_DIR=/var/lib/ragent-run/results
RAGENT_PROVIDER_HOMES_DIR=/var/lib/ragent-run/provider-homes
# External Codex owns refresh while it is logged into the selected account.
# Its latest credential is retained as a local fallback; after external logout
# or account switch, Ragent automatically resumes refresh ownership.
RAGENT_CODEX_NATIVE_EXTERNAL_OAUTH_OWNERSHIP=1
RAGENT_CODEX_EXTERNAL_OAUTH_HANDOFF_POLICY=automatic
PATH=/opt/ragent/runtime:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Use the native per-Run provider runtime. Provider selection and OAuth
# credentials are resolved from the native registry/SecretStore.
# Managed Agent creation is available by default for owner root sessions. The
# runtime still requires the signed approved-action channel and owner checks.
RAGENT_AGENT_CREATE_APPROVED_ACTION_ENABLED=1
# Autonomous multi-agent collaboration is enabled by default for packaged
# installs. Each flag remains an explicit opt-out so an operator can disable a
# slice without changing the source-level fallback used by development/tests.
RAGENT_ORG_SCHEMA_ENABLED=1
RAGENT_ORG_SHADOW_PROJECTION=1
RAGENT_ORG_SESSION_ADDRESSABILITY_ENABLED=1
RAGENT_MANAGED_INPUT_ENFORCEMENT=1
RAGENT_MANAGED_WRITER_ENABLED=1
RAGENT_REVIEWER_ENABLED=1
RAGENT_COLLABORATION_LEADER_ENABLED=1
RAGENT_ORG_INTERNAL_ENVELOPE_ENABLED=1
RAGENT_ORG_AUTONOMOUS_LEADER_ENABLED=1
RAGENT_ORG_AUTONOMOUS_PROVISIONING_ENABLED=1
RAGENT_ORG_AUTONOMOUS_AUTO_PROVISIONING_ENABLED=1
RAGENT_ORG_HIERARCHICAL_DELEGATION_ENABLED=1
RAGENT_ORG_DYNAMIC_REPLAN_ENABLED=1
RAGENT_ORG_STALL_GOVERNOR_ENABLED=1
RAGENT_ORG_PROJECTION_V1_ENABLED=1
RAGENT_ORG_PROJECTION_V2_ENABLED=1
RAGENT_ORG_RECOVERY_V1_ENABLED=1
RAGENT_CONSULTATION_V1_ENABLED=1
RAGENT_PRIVILEGED_EXECUTOR_SOCKET=/run/ragent-privileged-executor/sock
RAGENT_PRIVILEGED_EXECUTOR_AUDIT_FILE=/var/log/ragent-privileged/audit.jsonl
RAGENT_PRIVILEGED_EXECUTOR_GROUP=ragent-privileged

# Cloudflare Realtime TURN 由独立 turn-credential-broker.service 持有
# Cloudflare secret。Accounts capability 是默认认证方式；只有显式 static
# 或 dual 兼容部署才在此配置 broker token。缺少授权或 broker 凭据时
# fail-closed，不签发 TURN 候选。
# RAGENT_TURN_BROKER_URL=https://ragent.agentoncloud.com/turn
# RAGENT_TURN_BROKER_AUTH_MODE=static
# RAGENT_TURN_BROKER_TOKEN=
# RAGENT_TURN_BROKER_TIMEOUT_MS=5000
