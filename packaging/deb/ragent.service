[Unit]
Description=Ragent local AI workbench
After=network-online.target
Wants=network-online.target
After=ragent-privileged-executor.service
Wants=ragent-privileged-executor.service
After=ragent-runner-supervisor.service
Requires=ragent-runner-supervisor.service
After=ragent-runner-lifecycle.service
Requires=ragent-runner-lifecycle.service

[Service]
Type=simple
User=ragent
Group=ragent
SupplementaryGroups=ragent-privileged
WorkingDirectory=/opt/ragent/app
# The package may render deployment-specific owner-auth metadata at build time.
# Load it before the general conffile so an explicit operator value in
# ragent.env remains authoritative on upgrades.
EnvironmentFile=-/etc/ragent/account-auth.env
EnvironmentFile=/etc/ragent/ragent.env
# P2P 信令配置（RAGENT_P2P_SIGNALING_URL 等）；老包可能没有该文件，`-` 前缀表示可选
EnvironmentFile=-/etc/ragent/connectivity.env
# Match the systemd socket units even when an old conffile contains overrides.
EnvironmentFile=/usr/lib/ragent/socket-paths.env
ExecStartPre=/usr/lib/ragent/retire-legacy-cc-switch
# The + prefix runs this cheap state check as root even though the service
# itself runs as the configured owner. Full recursive state repair happens
# once during package configuration; restarts must not scan all history files.
ExecStartPre=+/usr/lib/ragent/repair-state-access --quick
# notify-exec pre-connects the notify socket and execs Node in place, so the
# main pid sends READY/WATCHDOG itself. That is what makes NotifyAccess=main
# safe here: forged notify messages from cgroup children (e.g. STOPPING=1,
# the 2026-08-31 silent restart-loop root cause) are rejected by systemd.
ExecStart=/usr/lib/ragent/notify-exec /opt/ragent/runtime/node /opt/ragent/app/chat-server.mjs
Restart=always
RestartSec=3
WatchdogSec=45s
NotifyAccess=main
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/lib/ragent /var/log/ragent

[Install]
WantedBy=multi-user.target
