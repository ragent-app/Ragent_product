[Unit]
Description=Ragent bounded storage inventory and retention pass
After=local-fs.target
ConditionPathIsDirectory=/var/lib/agentoc/config
ConditionPathIsDirectory=/var/lib/agentoc/workspace

[Service]
Type=oneshot
# postinst overrides this fallback with the configured non-root service user.
User=agentoc
Group=agentoc
WorkingDirectory=/opt/agentoc/app
EnvironmentFile=/etc/agentoc/agentoc.env
ExecStart=/opt/agentoc/runtime/node /opt/agentoc/app/scripts/storage-inventory-gc.mjs --apply --json --scheduled
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUWeight=1
IOWeight=1
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/lib/agentoc/config /var/lib/agentoc/workspace
TimeoutStartSec=30min
