[Unit]
Description=Ragent per-Run lifecycle broker socket
# P2-C: systemd owns the listening socket so it survives broker restarts and the
# socket file is created with the control-plane ownership declaratively.  Runs
# launch as the low-privilege ragent-runner user and can never reach it.

[Socket]
ListenStream=/var/lib/ragent/config/runner-lifecycle.sock
SocketUser=ragent
SocketGroup=ragent
SocketMode=0660
FileDescriptorName=ragent-runner-lifecycle.socket
Service=ragent-runner-lifecycle.service

[Install]
WantedBy=sockets.target
