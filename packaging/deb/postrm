#!/bin/sh
set -eu

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi

if [ "${1:-}" = purge ]; then
  # Finish an interrupted global-command diversion only when our marker and
  # exact empty target match; keep unrelated administrator diversions intact.
  for tool in codex claude; do
    command_path="/usr/bin/$tool"
    diverted_path="/usr/lib/ragent/legacy-global-$tool"
    marker="/etc/ragent/.legacy-global-$tool-diversion"
    [ -f "$marker" ] || continue
    [ "$(cat "$marker")" = "$diverted_path" ] || continue
    current_diversion="$(dpkg-divert --truename "$command_path")"
    if [ "$current_diversion" = "$diverted_path" ] \
        && [ "$(dpkg-divert --listpackage "$command_path")" = LOCAL ] \
        && [ ! -e "$diverted_path" ] && [ ! -L "$diverted_path" ]; then
      dpkg-divert --local --no-rename --remove --divert "$diverted_path" "$command_path"
      rm -f "$marker"
    elif [ "$current_diversion" = "$command_path" ]; then
      rm -f "$marker"
    fi
  done
  rm -rf /etc/systemd/system/ragent.service.d /etc/systemd/system/ragent-storage-gc.service.d /etc/systemd/system/ragent-runner-supervisor.service.d /etc/systemd/system/ragent-runner-supervisor.socket.d /etc/systemd/system/ragent-runner-lifecycle.socket.d
  rm -f /etc/ragent/service-user /etc/ragent/auth-secret /etc/ragent/initial-credentials
  rmdir /etc/ragent >/dev/null 2>&1 || true
  deluser --system ragent >/dev/null 2>&1 || true
  delgroup --system ragent >/dev/null 2>&1 || true
  delgroup --system ragent-privileged >/dev/null 2>&1 || true
  delgroup --system ragent-maintenance >/dev/null 2>&1 || true
fi

exit 0
