CHAT_BIND_HOST=127.0.0.1
CHAT_PORT=7690
SECURE_COOKIES=1
AGENTOC_CONFIG_DIR=/var/lib/agentoc/config
AGENTOC_WORK_ROOT_DIR=/var/lib/agentoc/workspace
AGENTOC_MEMORY_DIR=/var/lib/agentoc/memory
AGENTOC_CHAT_BASE_URL=http://127.0.0.1:7690
# P0-B: the lifecycle broker socket stays in the control-plane CONFIG_DIR,
# owned by the control user (root creates it in postinst).  The runner
# supervisor daemon runs as agentoc-runner, so ITS socket lives in the runner
# state root /var/lib/agentoc-run (created by postinst as
# agentoc-runner:agentoc-runners); the control plane connects through the
# shared agentoc-runners group.
AGENTOC_RUNNER_SUPERVISOR_SOCKET=/var/lib/agentoc-run/runner-supervisor.sock
AGENTOC_RUNNER_SUPERVISOR_REQUIRED=1
# Same-user runner mode: ordinary Runs use the configured service UID/GID so
# legacy user-owned worktrees remain readable and writable. Privileged group
# inheritance is still filtered by the fixed runner deny-list.
AGENTOC_RUNNER_SAME_USER=1
# Root-owned launcher creates one transient systemd cgroup per Run. During a
# rolling upgrade, leaving this empty preserves the legacy supervisor path.
AGENTOC_RUNNER_LIFECYCLE_SOCKET=/var/lib/agentoc/config/runner-lifecycle.sock
AGENTOC_RUNNER_LIFECYCLE_REQUIRED=1
# P0-C: the runner-accessible subtrees (run spool + provider credential homes)
# live under the runner state root, NOT under the control CONFIG_DIR.  This is
# what lets postinst drop the runner group's config traverse ACL.
AGENTOC_RUN_SPOOL_DIR=/var/lib/agentoc-run/results
AGENTOC_PROVIDER_HOMES_DIR=/var/lib/agentoc-run/provider-homes
# External Codex owns refresh while it is logged into the selected account.
# Its latest credential is retained as a local fallback; after external logout
# or account switch, Agentoc automatically resumes refresh ownership.
AGENTOC_CODEX_NATIVE_EXTERNAL_OAUTH_OWNERSHIP=1
AGENTOC_CODEX_EXTERNAL_OAUTH_HANDOFF_POLICY=automatic
PATH=/opt/agentoc/runtime:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Use the native per-Run provider runtime. Provider selection and OAuth
# credentials are resolved from the native registry/SecretStore.
# Managed Agent creation is available by default for owner root sessions. The
# runtime still requires the signed approved-action channel and owner checks.
AGENTOC_AGENT_CREATE_APPROVED_ACTION_ENABLED=1
# Autonomous multi-agent collaboration is enabled by default for packaged
# installs. Each flag remains an explicit opt-out so an operator can disable a
# slice without changing the source-level fallback used by development/tests.
AGENTOC_ORG_SCHEMA_ENABLED=1
AGENTOC_ORG_SHADOW_PROJECTION=1
AGENTOC_ORG_SESSION_ADDRESSABILITY_ENABLED=1
AGENTOC_MANAGED_INPUT_ENFORCEMENT=1
AGENTOC_MANAGED_WRITER_ENABLED=1
AGENTOC_REVIEWER_ENABLED=1
AGENTOC_COLLABORATION_LEADER_ENABLED=1
AGENTOC_ORG_INTERNAL_ENVELOPE_ENABLED=1
AGENTOC_ORG_AUTONOMOUS_LEADER_ENABLED=1
AGENTOC_ORG_AUTONOMOUS_PROVISIONING_ENABLED=1
AGENTOC_ORG_AUTONOMOUS_AUTO_PROVISIONING_ENABLED=1
AGENTOC_ORG_HIERARCHICAL_DELEGATION_ENABLED=1
AGENTOC_ORG_DYNAMIC_REPLAN_ENABLED=1
AGENTOC_ORG_STALL_GOVERNOR_ENABLED=1
AGENTOC_ORG_PROJECTION_V1_ENABLED=1
AGENTOC_ORG_PROJECTION_V2_ENABLED=1
AGENTOC_ORG_RECOVERY_V1_ENABLED=1
AGENTOC_CONSULTATION_V1_ENABLED=1
AGENTOC_PRIVILEGED_EXECUTOR_SOCKET=/run/agentoc-privileged-executor/sock
AGENTOC_PRIVILEGED_EXECUTOR_AUDIT_FILE=/var/log/agentoc-privileged/audit.jsonl
AGENTOC_PRIVILEGED_EXECUTOR_GROUP=agentoc-privileged

# Cloudflare Realtime TURN 由独立 turn-credential-broker.service 持有
# Cloudflare secret。Accounts capability 是默认认证方式；只有显式 static
# 或 dual 兼容部署才在此配置 broker token。缺少授权或 broker 凭据时
# fail-closed，不签发 TURN 候选。
# AGENTOC_TURN_BROKER_URL=https://agentoc.andyscodexagent.cyou/turn
# AGENTOC_TURN_BROKER_AUTH_MODE=static
# AGENTOC_TURN_BROKER_TOKEN=
# AGENTOC_TURN_BROKER_TIMEOUT_MS=5000
