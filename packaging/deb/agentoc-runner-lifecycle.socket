[Unit]
Description=Ragent per-Run lifecycle broker socket
# P2-C: systemd owns the listening socket so it survives broker restarts and the
# socket file is created with the control-plane ownership declaratively.  Runs
# launch as the low-privilege agentoc-runner user and can never reach it.

[Socket]
ListenStream=/var/lib/agentoc/config/runner-lifecycle.sock
SocketUser=agentoc
SocketGroup=agentoc
SocketMode=0660
Service=agentoc-runner-lifecycle.service

[Install]
WantedBy=sockets.target
