[Unit]
Description=Ragent detached runner supervisor
After=network-online.target
Wants=network-online.target
After=agentoc-runner-lifecycle.service
Requires=agentoc-runner-lifecycle.service

[Service]
Type=simple
# P2-C: the socket unit pre-binds the supervisor socket (systemd-owned, mode
# 0660 agentoc-runner:agentoc-runners); the daemon inherits the listening fd, so
# the socket survives supervisor restarts.  Sockets= implies Requires= + After=
# on agentoc-runner-supervisor.socket.
Sockets=agentoc-runner-supervisor.socket
# Same-user default: postinst overrides these package-safe fallback values with
# the configured service user/group. This keeps existing user-owned worktrees
# usable while the generated supplementary-group drop-in still removes
# privileged groups.
User=agentoc
Group=agentoc
# postinst writes 20-runner-inherited-groups.conf with the configured service
# user's ordinary, deny-listed supplementary groups.
WorkingDirectory=/opt/agentoc/app
EnvironmentFile=/etc/agentoc/agentoc.env
ExecStart=/opt/agentoc/runtime/node /opt/agentoc/app/chat/runner-supervisor-daemon.mjs
Restart=always
RestartSec=3
TimeoutStopSec=30
# The supervisor is a pure launcher (it only handles 'launch'/'health' requests);
# each runner is an independent sidecar that writes to its own spool file and is
# re-adopted by the chat-server on restart. KillMode=process ensures that stopping
# or restarting this unit (e.g. during a package deploy) kills ONLY the daemon, not
# the in-flight runner children — so active tasks survive restarts. The systemd
# default (control-group) would slaughter every running task on every deploy.
KillMode=process
# Provider sidecars launched by this supervisor must be able to reach the
# signed privileged executor. The sidecars still run as the configured
# non-root user with deny-listed supplementary groups; control-plane paths
# remain masked below.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
# The daemon imports the shared config module to derive the canonical run
# spool/provider paths. Keep the control-plane config tree read-only here;
# only the dedicated runner state root remains writable.
InaccessiblePaths=/etc/agentoc /var/log/agentoc /run/agentoc -/run/agentoc-privileged-executor
ReadOnlyPaths=/var/lib/agentoc
ReadWritePaths=/var/lib/agentoc-run

[Install]
WantedBy=multi-user.target
