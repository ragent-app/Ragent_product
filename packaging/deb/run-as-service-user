#!/bin/sh
set -eu

SERVICE_USER_FILE=/etc/ragent/service-user

trim_service_user() {
  printf '%s' "${1:-}" | tr -d '[:space:]'
}

resolve_service_user() {
  user="$(trim_service_user "${RAGENT_SERVICE_USER:-}")"
  if [ -z "$user" ] && [ -r "$SERVICE_USER_FILE" ]; then
    user="$(sed -n '1p' "$SERVICE_USER_FILE" | tr -d '[:space:]')"
  fi
  [ -n "$user" ] || user=ragent
  case "$user" in
    root|''|*[!A-Za-z0-9_.@-]*)
      echo "Invalid Ragent service user: $user" >&2
      exit 1
      ;;
  esac
  user_entry="$(getent passwd "$user" || true)"
  [ -n "$user_entry" ] || {
    echo "Ragent service user does not exist: $user" >&2
    exit 1
  }
  user_uid="$(printf '%s\n' "$user_entry" | awk -F: '{ print $3 }')"
  case "$user_uid" in
    ''|*[!0-9]*) echo "Cannot verify Ragent service user identity: $user" >&2; exit 1 ;;
    *) if ! [ "$user_uid" -gt 0 ] 2>/dev/null; then
      echo "Ragent service user must be a non-root local user." >&2
      exit 1
    fi ;;
  esac
  user_gid="$(printf '%s\n' "$user_entry" | awk -F: '{ print $4 }')"
  case "$user_gid" in
    ''|*[!0-9]*) echo "Cannot verify Ragent service user group: $user" >&2; exit 1 ;;
    *) if ! [ "$user_gid" -gt 0 ] 2>/dev/null; then
      echo "Ragent service user must not use the root group." >&2
      exit 1
    fi ;;
  esac
  printf '%s\n' "$user"
}

service_user="$(resolve_service_user)"
service_home="$(getent passwd "$service_user" | awk -F: '{ print $6 }' || true)"
[ -n "$service_home" ] || service_home=/var/lib/ragent

export HOME="$service_home"
export RAGENT_CONFIG_DIR=/var/lib/ragent/config
export RAGENT_WORK_ROOT_DIR=/var/lib/ragent/workspace
export RAGENT_CHAT_BASE_URL=http://127.0.0.1:7690
export PATH=/opt/ragent/runtime:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

if [ -r /etc/ragent/connectivity.env ]; then
  set -a
  . /etc/ragent/connectivity.env
  set +a
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "Administrator authorization is required." >&2
  exit 1
fi

exec runuser -u "$service_user" -- env \
  HOME="$HOME" \
  RAGENT_SESSION_ID="${RAGENT_SESSION_ID:-}" \
  RAGENT_RUN_ID="${RAGENT_RUN_ID:-}" \
  RAGENT_PROJECT_ROOT="${RAGENT_PROJECT_ROOT:-}" \
  RAGENT_SESSION_CONTROL_TOKEN="${RAGENT_SESSION_CONTROL_TOKEN:-}" \
  RAGENT_SESSION_CONTROL_RENEWAL_TOKEN="${RAGENT_SESSION_CONTROL_RENEWAL_TOKEN:-}" \
  RAGENT_SESSION_CONTROL_RENEWAL_TOKEN_FILE="${RAGENT_SESSION_CONTROL_RENEWAL_TOKEN_FILE:-}" \
  RAGENT_SESSION_CONTROL_RUN_ID="${RAGENT_SESSION_CONTROL_RUN_ID:-}" \
  RAGENT_SESSION_CONTROL_SESSION_ID="${RAGENT_SESSION_CONTROL_SESSION_ID:-}" \
  RAGENT_SESSION_CONTROL_TURN_ID="${RAGENT_SESSION_CONTROL_TURN_ID:-}" \
  RAGENT_P2P_SIGNALING_URL="${RAGENT_P2P_SIGNALING_URL:-}" \
  /opt/ragent/runtime/node /opt/ragent/app/cli.js "$@"
