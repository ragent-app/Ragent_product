[Unit]
Description=Ragent per-Run lifecycle broker
After=local-fs.target
Before=ragent-runner-supervisor.service ragent.service

[Service]
Type=simple
# P2-C: the socket unit pre-binds the broker socket (systemd-owned, mode 0660
# ragent:ragent); the daemon inherits the listening fd, so the socket survives
# broker restarts.  Sockets= implies Requires= + After= on
# ragent-runner-lifecycle.socket.
Sockets=ragent-runner-lifecycle.socket
User=root
Group=root
# The supervisor and transient runners mask this control-plane path. systemd
# requires it to exist before it can set up their mount namespaces on a clean
# installation and after every reboot.
RuntimeDirectory=ragent
RuntimeDirectoryMode=0755
WorkingDirectory=/opt/ragent/app
# EnvironmentFile overrides this default when an administrator explicitly
# configures the mode, without modifying the operator's dpkg conffile.
Environment=RAGENT_RUNNER_DROP_GROUPS=auto
EnvironmentFile=/etc/ragent/ragent.env
# Match the systemd socket units even when an old conffile contains overrides.
EnvironmentFile=/usr/lib/ragent/socket-paths.env
ExecStart=/opt/ragent/runtime/node /opt/ragent/app/scripts/runner-lifecycle-broker.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=false
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/ragent
UMask=0007

[Install]
WantedBy=multi-user.target
