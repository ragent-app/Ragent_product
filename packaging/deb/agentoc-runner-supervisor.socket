[Unit]
Description=Ragent detached runner supervisor socket
# P2-C: systemd owns the listening socket so it survives supervisor restarts
# (no ECONNREFUSED window during Restart=always) and the socket file is created
# with the service-user permissions declaratively instead of by the daemon.

[Socket]
ListenStream=/var/lib/agentoc-run/runner-supervisor.sock
SocketUser=agentoc
SocketGroup=agentoc
SocketMode=0660
Service=agentoc-runner-supervisor.service

[Install]
WantedBy=sockets.target
