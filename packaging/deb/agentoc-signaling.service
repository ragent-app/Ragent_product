[Unit]
Description=Ragent P2P metadata-only signaling server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentoc
Group=agentoc
WorkingDirectory=/opt/agentoc/app
EnvironmentFile=/etc/agentoc/agentoc.env
# P2P 信令监听配置（AGENTOC_P2P_SIGNAL_HOST/PORT 等）；老包可能没有该文件，`-` 前缀表示可选
EnvironmentFile=-/etc/agentoc/connectivity.env
ExecStart=/opt/agentoc/runtime/node /opt/agentoc/app/cli.js signal
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/lib/agentoc

[Install]
WantedBy=multi-user.target
