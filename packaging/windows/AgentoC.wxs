<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="AgentoC Legacy SYSTEM Preview (not for distribution)" Manufacturer="AgentoC" Version="$(var.MsiProductVersion)" UpgradeCode="2D1D9C6B-5BA7-4C70-9A7A-7E7A55E3A001" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer AgentoC version is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AgentoCIcon" SourceFile="!(bindpath.BrandAsset)\agentoc.ico" />
    <Property Id="ARPPRODUCTICON" Value="AgentoCIcon" />
    <Property Id="AGENTOC_INSTALLFOLDER" Secure="yes" />
    <Property Id="AGENTOC_LAUNCH" Secure="yes" />
    <CustomAction Id="SetSelectedInstallFolder" Directory="INSTALLFOLDER" Value="[AGENTOC_INSTALLFOLDER]" />
    <CustomAction Id="SetAgentoCLaunchTarget" Property="WixUnelevatedShellExecTarget" Value="[INSTALLFOLDER]payload\Desktop\Ragent.exe" />
    <CustomAction Id="LaunchAgentoC" BinaryRef="Wix4UtilCA_X64" DllEntry="WixUnelevatedShellExec" Execute="immediate" Return="ignore" />
    <util:CloseApplication Id="CloseAgentoCManager" Target="Ragent.exe" CloseMessage="yes" PromptToContinue="yes" Description="Ragent is still open. Close it to continue setup or removal." Timeout="15" />
    <UI>
      <EmbeddedUI Id="AgentoCMsiEmbeddedUI" SourceFile="!(bindpath.InstallUi)\AgentoC.MsiEmbeddedUI.dll" SupportBasicUI="yes">
        <EmbeddedUIResource Id="AgentoCEmbeddedLogo" Name="agentoc-android-logo.png" SourceFile="!(bindpath.InstallUi)\agentoc-android-logo.png" />
        <EmbeddedUIResource Id="AgentoCEmbeddedIcon" Name="agentoc.ico" SourceFile="!(bindpath.InstallUi)\agentoc.ico" />
        <?if $(var.IncludeMingwUiRuntime) = 1 ?>
          <EmbeddedUIResource Id="AgentoCMingwThreadRuntime" Name="libwinpthread-1.dll" SourceFile="!(bindpath.InstallUi)\libwinpthread-1.dll" />
        <?endif ?>
      </EmbeddedUI>
    </UI>
    <Binary Id="LegacyOwnerInstallGuard" SourceFile="!(bindpath.OwnerInstallGuard)\AgentoC.LegacyOwnerInstallGuard.exe" />
    <CustomAction Id="CheckLegacyOwnerInstallation" BinaryRef="LegacyOwnerInstallGuard" ExeCommand="" Execute="immediate" Return="check" />
    <InstallExecuteSequence>
      <!-- Unconditional: install, repair, upgrade, remove and silent execution. -->
      <Custom Action="SetSelectedInstallFolder" After="CostFinalize" Condition="AGENTOC_INSTALLFOLDER AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="CheckLegacyOwnerInstallation" Before="InstallValidate" />
      <Custom Action="SetAgentoCLaunchTarget" After="InstallFinalize" Condition="AGENTOC_LAUNCH = &quot;1&quot; AND NOT Installed" />
      <Custom Action="LaunchAgentoC" After="SetAgentoCLaunchTarget" Condition="AGENTOC_LAUNCH = &quot;1&quot; AND NOT Installed" />
    </InstallExecuteSequence>
    <Feature Id="Main" Title="AgentoC" Level="1">
      <ComponentRef Id="ServiceHostComponent" />
      <ComponentGroupRef Id="PayloadGroup" />
      <ComponentRef Id="InstallScriptComponent" />
      <ComponentRef Id="LegacyOwnerGuardScriptComponent" />
      <ComponentRef Id="LegacyOwnerGuardSourceComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>
  </Package>
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AgentoC" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AgentoC" />
    </StandardDirectory>
    <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="AgentoCStartMenuShortcut" Name="Ragent" Target="[INSTALLFOLDER]payload\Desktop\Ragent.exe" WorkingDirectory="INSTALLFOLDER" Icon="AgentoCIcon" IconIndex="0" Advertise="no" />
      <RemoveFolder Id="RemoveAgentoCProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\AgentoC\DesktopManager" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="ServiceHostComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="ServiceHost" Source="!(bindpath.ServiceHost)\AgentoC.ServiceHost.exe" KeyPath="yes" />
      <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\AgentoC">
        <RegistryValue Name="EventMessageFile" Type="string" Value="[System64Folder]EventCreate.exe" />
        <RegistryValue Name="TypesSupported" Type="integer" Value="7" />
      </RegistryKey>
      <ServiceInstall Id="ControlPlaneService" Name="AgentoC-ControlPlane" DisplayName="AgentoC Control Plane" Type="ownProcess" Start="auto" ErrorControl="normal" Arguments="--role control --config-dir &quot;[CommonAppDataFolder]AgentoC\instances\owner\config&quot; --instance-root &quot;[CommonAppDataFolder]AgentoC\instances\owner&quot;">
        <ServiceDependency Id="AgentoC-RunnerSupervisor" />
      </ServiceInstall>
      <ServiceInstall Id="RunnerSupervisorService" Name="AgentoC-RunnerSupervisor" DisplayName="AgentoC Runner Supervisor" Type="ownProcess" Start="auto" ErrorControl="normal" Arguments="--role supervisor --config-dir &quot;[CommonAppDataFolder]AgentoC\instances\owner\executor\config&quot; --instance-root &quot;[CommonAppDataFolder]AgentoC\instances\owner&quot;" />
      <ServiceControl Id="RunnerSupervisorServiceControl" Name="AgentoC-RunnerSupervisor" Start="install" Stop="both" Remove="uninstall" />
      <ServiceControl Id="ControlPlaneServiceControl" Name="AgentoC-ControlPlane" Start="install" Stop="both" Remove="uninstall" />
    </Component>
    <Component Id="InstallScriptComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="InstallScript" Source="!(bindpath.InstallScript)\install-agentoc.ps1" KeyPath="yes" />
    </Component>
    <Component Id="LegacyOwnerGuardScriptComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="LegacyOwnerGuardScript" Source="!(bindpath.InstallScript)\assert-legacy-owner-install.ps1" KeyPath="yes" />
    </Component>
    <Component Id="LegacyOwnerGuardSourceComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="LegacyOwnerGuardSource" Source="!(bindpath.InstallScript)\legacy-owner-install-guard.cs" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
